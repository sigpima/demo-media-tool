# Example only — merge into your existing nginx config; you already have TLS/domain set up.

# http { } context:
limit_req_zone $binary_remote_addr zone=cbt:10m rate=20r/s;

# inside your existing server { listen 443 ssl; server_name tools.example.com; ... }
# Invite links carry a secret token in the URL: keep it out of nginx's access log.
location /invite/ {
    access_log off;
    proxy_pass http://127.0.0.1:8000;
    proxy_set_header Host            $http_host;
    proxy_set_header X-Real-IP       $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    limit_req zone=cbt burst=5 nodelay;
}

location / {
    proxy_pass http://127.0.0.1:8000;

    # The app trusts these (CBT_TRUST_PROXY=true) for per-IP rate limits, so ALWAYS overwrite them:
    proxy_set_header Host              $http_host;   # keep the port: the app compares it with the browser's Origin
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    client_max_body_size 30m;          # one image per upload request; keep slightly above CBT_MAX_FILE_MB
    proxy_request_buffering on;        # nginx buffers the body, so the app always sees a Content-Length
    proxy_read_timeout  120s;
    proxy_send_timeout  120s;

    limit_req zone=cbt burst=60 nodelay;   # status polling + uploads are bursty; the app has its own limits too
}
