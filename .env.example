# Copy to .env and edit. Required: CBT_IMAGE and the two auth lines (the app refuses to start without a strong password).

# Which image to run. CI publishes it to GitHub Container Registry (lowercase!).
CBT_IMAGE=ghcr.io/your-github-user/creative-batch-toolkit
# latest = newest main build · sha-abc1234 = one exact build (use for rollback) · v1.2.3 = a release
CBT_TAG=latest

CBT_BASIC_AUTH_USER=admin
# Password: at least 12 characters (generate one with: openssl rand -base64 24)
# (avoid the $ character: docker compose treats it as a variable)
CBT_BASIC_AUTH_PASSWORD=change-me-to-a-long-random-password

# Limits (defaults shown)
# CBT_MAX_FILE_MB=25
# CBT_MAX_FILES_PER_BATCH=100
# CBT_MAX_PIXELS=64000000
# CBT_CONCURRENCY=3
# CBT_TTL_HOURS=24
# CBT_MAX_STORAGE_MB=4096
# CBT_MAX_ACTIVE_BATCHES_PER_IP=10
# CBT_RATE_BATCHES_PER_HOUR=30

# Invite links for guests (HR, trial users) — create them with:
#   docker compose exec app python -m app.invites create --label "ACME HR" --base-url https://tools.example.com
# CBT_INVITE_TTL_DAYS=7
# CBT_INVITE_MAX_FILES_PER_BATCH=20
# CBT_INVITE_MAX_FILE_MB=10
# CBT_INVITE_IMAGES_PER_DAY=200
